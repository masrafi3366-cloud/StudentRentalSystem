@model IEnumerable<StudentRentalSystem.Models.Student>



@{
    ViewData["Title"] = "Admin Dashboard";
}




<div class="container mt-4">





    <h2 class="mb-4">

        Admin Dashboard 🛠️

    </h2>








    <!-- STATISTICS SECTION -->



    <div class="row mb-4">





        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Total Students
                    </h5>


                    <h2 class="text-primary">

                        @ViewBag.TotalStudents

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Approved Students
                    </h5>


                    <h2 class="text-success">

                        @ViewBag.ApprovedStudents

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Pending Students
                    </h5>


                    <h2 class="text-warning">

                        @ViewBag.PendingStudents

                    </h2>


                </div>


            </div>


        </div>



    </div>









    <!-- ITEM STATISTICS -->



    <div class="row mb-4">





        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Total Items 📦
                    </h5>


                    <h2 class="text-primary">

                        @ViewBag.TotalItems

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Available Items
                    </h5>


                    <h2 class="text-success">

                        @ViewBag.AvailableItems

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Rented Items
                    </h5>


                    <h2 class="text-danger">

                        @ViewBag.RentedItems

                    </h2>


                </div>


            </div>


        </div>




    </div>









    <!-- RENTAL PAYMENT STATISTICS -->



    <div class="row mb-4">





        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Total Rentals 🔄
                    </h5>


                    <h2 class="text-info">

                        @ViewBag.TotalRentals

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Completed Payments 💳
                    </h5>


                    <h2 class="text-success">

                        @ViewBag.CompletedPayments

                    </h2>


                </div>


            </div>


        </div>








        <div class="col-md-4 mb-3">


            <div class="card shadow text-center">


                <div class="card-body">


                    <h5>
                        Total Revenue 💰
                    </h5>


                    <h2 class="text-primary">

                        ৳ @ViewBag.TotalRevenue

                    </h2>


                </div>


            </div>


        </div>




    </div>









    <!-- ADMIN MANAGEMENT MENU -->



    <div class="row mb-4">





        <div class="col-md-6 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5>

                        Item Management 📦

                    </h5>



                    <p>

                        Review posted items and manage approval.

                    </p>



                    <a href="/Admin/Dashboard/Items"
                       class="btn btn-primary">


                        Manage Items


                    </a>


                </div>


            </div>


        </div>








        <div class="col-md-6 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5>

                        Rental Monitoring 📋

                    </h5>



                    <p>

                        Monitor rental and payment activities.

                    </p>



                    <a href="/Admin/Dashboard/Rentals"
                       class="btn btn-info">


                        View Rentals


                    </a>


                </div>


            </div>


        </div>



    </div>









    <!-- STUDENT VERIFICATION -->



    <div class="card shadow">


        <div class="card-body">



            <h4 class="mb-3">

                Student Verification Requests

            </h4>







            @if (Model == null || !Model.Any())
            {

                <div class="alert alert-info text-center">

                    No student registration request available.

                </div>

            }

            else
            {


                <div class="table-responsive">


                    <table class="table table-bordered table-hover align-middle">


                        <thead class="table-dark">


                            <tr>

                                <th>ID</th>

                                <th>Name</th>

                                <th>Mobile</th>

                                <th>Email</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>


                        </thead>





                        <tbody>


                            @foreach (var student in Model)
                            {


                                <tr>


                                    <td>
                                        @student.StudentId
                                    </td>


                                    <td>
                                        @student.FullName
                                    </td>


                                    <td>
                                        @student.Mobile
                                    </td>


                                    <td>
                                        @student.Email
                                    </td>


                                    <td>


                                        @if (student.IsApproved)
                                        {

                                            <span class="badge bg-success">

                                                Approved

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                        }


                                    </td>


                                    <td>


                                        <a href="/Admin/Dashboard/StudentDetails/@student.StudentId"
                                           class="btn btn-primary btn-sm">

                                            Details

                                        </a>





                                        @if (!student.IsApproved)
                                        {

                                            <a href="/Admin/Dashboard/Approve/@student.StudentId"
                                               class="btn btn-success btn-sm">

                                                Approve

                                            </a>


                                            <a href="/Admin/Dashboard/Reject/@student.StudentId"
                                               class="btn btn-danger btn-sm">

                                                Reject

                                            </a>

                                        }


                                    </td>


                                </tr>


                            }


                        </tbody>


                    </table>


                </div>


            }



        </div>


    </div>





</div>