@model IEnumerable<StudentRentalSystem.Models.Student>


@{
    ViewData["Title"] = "Admin Dashboard";
}



<style>


    .admin-title {
        color: #20B2AA;
        font-weight: 700;
    }



    .stat-card {
        border: none;
        border-radius: 15px;
        transition: .3s;
    }



        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(32,178,170,.25) !important;
        }



    .stat-number {
        color: #20B2AA;
        font-size: 35px;
        font-weight: bold;
    }



    .sea-btn {
        background: #20B2AA;
        border-color: #20B2AA;
        color: white;
    }



        .sea-btn:hover {
            background: #178F89;
            color: white;
        }



    .table thead {
        background: #20B2AA;
        color: white;
    }

</style>









<div class="container mt-4">





    <div class="text-center mb-4">


        <h2 class="admin-title">

            🛠️ Admin Dashboard

        </h2>


        <p class="text-muted">

            Student Rental System Management Panel

        </p>


    </div>









    <!-- STUDENT STATS -->


    <div class="row mb-4">


        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">


                    <h6>

                        Total Students

                    </h6>


                    <div class="stat-number">

                        @ViewBag.TotalStudents

                    </div>


                </div>

            </div>

        </div>







        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">


                    <h6>

                        Approved Students

                    </h6>


                    <div class="stat-number">

                        @ViewBag.ApprovedStudents

                    </div>


                </div>

            </div>

        </div>







        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">


                    <h6>

                        Pending Students

                    </h6>


                    <div class="stat-number">

                        @ViewBag.PendingStudents

                    </div>


                </div>

            </div>

        </div>


    </div>









    <!-- ITEM RENTAL PAYMENT -->


    <div class="row mb-4">


        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h6>
                        📦 Total Items
                    </h6>


                    <div class="stat-number">

                        @ViewBag.TotalItems

                    </div>


                </div>

            </div>

        </div>







        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h6>
                        Available Items
                    </h6>


                    <div class="stat-number">

                        @ViewBag.AvailableItems

                    </div>


                </div>

            </div>

        </div>







        <div class="col-md-4 mb-3">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h6>
                        Rented Items
                    </h6>


                    <div class="stat-number">

                        @ViewBag.RentedItems

                    </div>


                </div>

            </div>

        </div>


    </div>









    <div class="row mb-4">


        <div class="col-md-4 mb-3">


            <div class="card shadow stat-card text-center">


                <div class="card-body">


                    <h6>
                        🔄 Total Rentals
                    </h6>


                    <div class="stat-number">

                        @ViewBag.TotalRentals

                    </div>


                </div>


            </div>


        </div>







        <div class="col-md-4 mb-3">


            <div class="card shadow stat-card text-center">


                <div class="card-body">


                    <h6>
                        💳 Payments
                    </h6>


                    <div class="stat-number">

                        @ViewBag.CompletedPayments

                    </div>


                </div>


            </div>


        </div>







        <div class="col-md-4 mb-3">


            <div class="card shadow stat-card text-center">


                <div class="card-body">


                    <h6>
                        💰 Revenue
                    </h6>


                    <div class="stat-number">

                        ৳ @ViewBag.TotalRevenue

                    </div>


                </div>


            </div>


        </div>


    </div>









    <!-- SEARCH -->


    <div class="card shadow mb-4">


        <div class="card-body">


            <h5>

                🔍 Search Students

            </h5>



            <form method="get"
                  action="/Admin/Dashboard/Index">


                <div class="input-group">


                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search student..." />



                    <button class="btn sea-btn">

                        Search

                    </button>


                </div>


            </form>



        </div>


    </div>









    <!-- MANAGEMENT -->


    <div class="row mb-4">


        <div class="col-md-6 mb-3">


            <div class="card shadow">


                <div class="card-body">


                    <h5>
                        📦 Item Management
                    </h5>


                    <p>

                        Manage student posted items.

                    </p>


                    <a href="/Admin/Dashboard/Items"
                       class="btn sea-btn">

                        Manage Items

                    </a>


                </div>


            </div>


        </div>








        <div class="col-md-6 mb-3">


            <div class="card shadow">


                <div class="card-body">


                    <h5>
                        📋 Rental Monitoring
                    </h5>


                    <p>

                        Monitor rentals and payments.

                    </p>


                    <a href="/Admin/Dashboard/Rentals"
                       class="btn btn-info">

                        View Rentals

                    </a>


                </div>


            </div>


        </div>


    </div>









    <!-- STUDENT TABLE -->


    <div class="card shadow">


        <div class="card-body">


            <h4 class="mb-3">

                Student Verification

            </h4>





            <div class="table-responsive">


                <table class="table table-bordered table-hover align-middle">


                    <thead>


                        <tr>

                            <th>ID</th>

                            <th>Name</th>

                            <th>Mobile</th>

                            <th>Email</th>

                            <th>Status</th>

                            <th>Action</th>


                        </tr>


                    </thead>



                    <tbody>


                        @foreach (var student in Model)
                        {


                            <tr>


                                <td>
                                    @student.StudentId
                                </td>


                                <td>
                                    @student.FullName
                                </td>


                                <td>
                                    @student.Mobile
                                </td>


                                <td>
                                    @student.Email
                                </td>


                                <td>


                                    @if (student.IsApproved)
                                    {

                                        <span class="badge bg-success">

                                            Approved

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="badge bg-warning text-dark">

                                            Pending

                                        </span>

                                    }


                                </td>


                                <td>


                                    <a href="/Admin/Dashboard/StudentDetails/@student.StudentId"
                                       class="btn btn-primary btn-sm">

                                        Details

                                    </a>



                                    @if (!student.IsApproved)
                                    {


                                        <a href="/Admin/Dashboard/Approve/@student.StudentId"
                                           class="btn btn-success btn-sm">

                                            Approve

                                        </a>


                                        <a href="/Admin/Dashboard/Reject/@student.StudentId"
                                           class="btn btn-danger btn-sm">

                                            Reject

                                        </a>


                                    }



                                </td>


                            </tr>


                        }



                    </tbody>


                </table>


            </div>



        </div>


    </div>






</div>