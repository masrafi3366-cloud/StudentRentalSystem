@model StudentRentalSystem.Models.Student


@{
    ViewData["Title"] = "Student Details";
}




<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-8">



            <div class="card shadow p-4">





                <h2 class="text-center mb-4">

                    Student Details 🪪

                </h2>







                <hr />








                <div class="row">






                    <div class="col-md-7">



                        <p>

                            <strong>
                                Student ID:
                            </strong>


                            @Model.StudentId


                        </p>







                        <p>

                            <strong>
                                Full Name:
                            </strong>


                            @Model.FullName


                        </p>







                        <p>

                            <strong>
                                Mobile:
                            </strong>


                            @Model.Mobile


                        </p>








                        <p>

                            <strong>
                                Email:
                            </strong>


                            @Model.Email


                        </p>








                        <p>

                            <strong>
                                Father's Number:
                            </strong>


                            @Model.FathersNumber


                        </p>








                        <p>

                            <strong>
                                Mother's Number:
                            </strong>


                            @Model.MothersNumber


                        </p>








                        <p>

                            <strong>
                                Registration Date:
                            </strong>


                            @Model.RegistrationDate.ToShortDateString()


                        </p>








                        <p>

                            <strong>
                                Status:
                            </strong>





                            @if (Model.IsApproved)
                            {

                                <span class="badge bg-success">

                                    Approved

                                </span>

                            }

                            else
                            {

                                <span class="badge bg-warning text-dark">

                                    Pending

                                </span>

                            }



                        </p>





                    </div>









                    <div class="col-md-5 text-center">



                        <h5>

                            Student ID Card

                        </h5>





                        @if (!string.IsNullOrEmpty(Model.StudentIdCardImage))
                        {

                            <img src="@Model.StudentIdCardImage"
                                 class="img-fluid rounded shadow"
                                 style="max-height:250px;" />

                        }

                        else
                        {

                            <p class="text-muted">

                                No ID Card Uploaded

                            </p>

                        }



                    </div>







                </div>









                <hr />









                <div class="text-center">





                    @if (!Model.IsApproved)
                    {



                        <a href="/Admin/Dashboard/Approve/@Model.StudentId"
                           class="btn btn-success me-2"
                           onclick="return confirm('Approve this student?');">


                            Approve


                        </a>







                        <a href="/Admin/Dashboard/Reject/@Model.StudentId"
                           class="btn btn-danger"
                           onclick="return confirm('Reject this student?');">


                            Reject


                        </a>



                    }

                    else
                    {


                        <span class="badge bg-success p-2">

                            Student Verified

                        </span>


                    }





                </div>








                <div class="text-center mt-4">



                    <a href="/Admin/Dashboard"
                       class="btn btn-outline-primary">


                        Back Dashboard


                    </a>



                </div>







            </div>


        </div>


    </div>


</div>