@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "Item Approval";
}




<div class="container mt-4">





    <h2 class="mb-4">

        Item Approval Management 📦

    </h2>








    <!-- SEARCH + FILTER -->



    <div class="card shadow mb-4">


        <div class="card-body">


            <form method="get"
                  action="/Admin/Dashboard/Items">



                <div class="row">



                    <div class="col-md-6 mb-2">


                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search item name..." />


                    </div>








                    <div class="col-md-4 mb-2">


                        <select name="category"
                                class="form-control">


                            <option value="">
                                All Categories
                            </option>



                            @if (ViewBag.Categories != null)
                            {


                                foreach (var cat in ViewBag.Categories)
                                {


                                    <option value="@cat">

                                        @cat

                                    </option>


                                }


                            }


                        </select>


                    </div>








                    <div class="col-md-2 mb-2">


                        <button type="submit"
                                class="btn btn-primary w-100">


                            Search


                        </button>


                    </div>




                </div>



            </form>


        </div>


    </div>









    @if (Model == null || !Model.Any())
    {


        <div class="alert alert-info text-center">

            No items found.

        </div>


    }

    else
    {




        <div class="table-responsive">


            <table class="table table-bordered table-hover shadow align-middle">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Image
                        </th>


                        <th>
                            Item
                        </th>


                        <th>
                            Owner
                        </th>


                        <th>
                            Category
                        </th>


                        <th>
                            Price
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>







                <tbody>



                    @foreach (var item in Model)
                    {


                        <tr>



                            <td>


                                @if (!string.IsNullOrEmpty(item.Image))
                                {


                                    <img src="@item.Image"
                                         width="90"
                                         height="70"
                                         class="rounded shadow"
                                         style="object-fit:cover;" />


                                }
                                else
                                {

                                    <span class="text-muted">

                                        No Image

                                    </span>

                                }



                            </td>








                            <td>


                                <strong>

                                    @item.ItemName

                                </strong>



                                <br />


                                <small class="text-muted">

                                    ID: @item.ItemId

                                </small>


                            </td>








                            <td>


                                <strong>

                                    @(ViewData["Owner_" + item.ItemId])

                                </strong>


                            </td>








                            <td>

                                <span class="badge bg-info text-dark">

                                    @item.Category

                                </span>


                            </td>








                            <td>

                                ৳ @item.PricePerDay / day


                            </td>








                            <td>




                                @if (item.IsRented)
                                {


                                    <span class="badge bg-danger">

                                        Rented

                                    </span>


                                }

                                else if (item.AdminApproved)
                                {


                                    <span class="badge bg-success">

                                        Available

                                    </span>


                                }

                                else
                                {


                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>


                                }




                            </td>









                            <td>




                                <a href="/Admin/Dashboard/ItemDetails/@item.ItemId"
                                   class="btn btn-primary btn-sm mb-1">


                                    Details


                                </a>







                                @if (!item.AdminApproved)
                                {


                                    <br />



                                    <a href="/Admin/Dashboard/ApproveItem/@item.ItemId"
                                       class="btn btn-success btn-sm mb-1"
                                       onclick="return confirm('Approve this item?');">


                                        Approve


                                    </a>







                                    <a href="/Admin/Dashboard/RejectItem/@item.ItemId"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Reject this item?');">


                                        Reject


                                    </a>



                                }

                                else
                                {


                                    <br />



                                    <span class="badge bg-success">

                                        Verified

                                    </span>


                                }





                            </td>





                        </tr>


                    }



                </tbody>



            </table>



        </div>


    }



</div>