@model IEnumerable<StudentRentalSystem.Models.ViewModels.AdminRentalViewModel>



@{
    ViewData["Title"] = "Rental Monitoring";
}





<div class="container mt-4">


    <h2 class="mb-4">

        Rental & Payment Monitoring 💳

    </h2>





    <table class="table table-bordered table-hover shadow">


        <thead class="table-dark">


            <tr>


                <th>
                    Rental ID
                </th>


                <th>
                    Student
                </th>


                <th>
                    Item
                </th>


                <th>
                    Date
                </th>


                <th>
                    Days
                </th>


                <th>
                    Amount
                </th>


                <th>
                    Rental Status
                </th>


                <th>
                    Payment
                </th>


            </tr>


        </thead>





        <tbody>



            @foreach (var rental in Model)
            {


                <tr>


                    <td>

                        @rental.RentalId

                    </td>





                    <td>

                        @rental.StudentName

                    </td>






                    <td>

                        @rental.ItemName

                    </td>






                    <td>

                        @rental.StartDate.ToShortDateString()

                        <br />

                        @rental.EndDate.ToShortDateString()

                    </td>






                    <td>

                        @rental.RentalDays

                    </td>






                    <td>

                        ৳ @rental.TotalAmount

                    </td>







                    <td>


                        <span class="badge bg-info">

                            @rental.RentalStatus

                        </span>


                    </td>







                    <td>



                        @if (rental.PaymentStatus == "Completed")
                        {

                            <span class="badge bg-success">

                                Paid

                            </span>


                            <br />


                            <small>

                                @rental.TransactionId

                            </small>


                        }

                        else
                        {

                            <span class="badge bg-warning text-dark">

                                Pending

                            </span>

                        }



                    </td>





                </tr>


            }



        </tbody>



    </table>



</div>