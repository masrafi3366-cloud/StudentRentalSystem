@{
    ViewData["Title"] = "Admin Login";
}



<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-5">


            <div class="card shadow p-4">


                <h2 class="text-center mb-4">

                    Admin Login

                </h2>





                @if (ViewBag.Error != null)
                {

                    <div class="alert alert-danger">

                        @ViewBag.Error

                    </div>

                }






                <form method="post"
                      action="/Admin/Admin/Login">





                    <div class="mb-3">


                        <label class="form-label">

                            Email

                        </label>


                        <input type="email"
                               name="email"
                               class="form-control"
                               required />


                    </div>







                    <div class="mb-3">


                        <label class="form-label">

                            Password

                        </label>


                        <input type="password"
                               name="password"
                               class="form-control"
                               required />


                    </div>







                    <button type="submit"
                            class="btn btn-dark w-100">

                        Login

                    </button>



                </form>



            </div>


        </div>


    </div>


</div>