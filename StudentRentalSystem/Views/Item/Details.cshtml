@model StudentRentalSystem.Models.Item


<h2>
    Item Details
</h2>


<hr />


<img src="@Model.Image"
     width="300" />



<h3>
    @Model.ItemName
</h3>



<p>
    Category:

    @Model.Category

</p>



<p>
    Description:

    @Model.Description

</p>



<p>
    Price Per Day:

    @Model.PricePerDay

</p>




<br />


<a href="/Rental/Create/@Model.ItemId">
    Rent Now
</a>