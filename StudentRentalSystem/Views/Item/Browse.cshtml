@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "Browse Items";
}



<style>


    .item-card {
        transition: 0.3s;
    }



        .item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(32,178,170,0.25) !important;
        }



    .sea-btn {
        background-color: #20B2AA;
        border-color: #20B2AA;
        color: white;
    }



        .sea-btn:hover {
            background-color: #178F89;
            border-color: #178F89;
            color: white;
        }



    .category-badge {
        background-color: #20B2AA;
        color: white;
        padding: 8px 12px;
        border-radius: 20px;
    }



    .price-text {
        color: #178F89;
        font-size: 18px;
        font-weight: bold;
    }

</style>







<div class="container mt-4">






    <h2 class="mb-4 text-center fw-bold"
        style="color:#20B2AA;">


        Browse Available Items 🔍


    </h2>








    <!-- SEARCH FILTER -->


    <form method="get"
          action="/Item/Browse"
          class="card shadow p-3 mb-4">





        <div class="row g-2">





            <div class="col-md-5">


                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search item name..." />


            </div>








            <div class="col-md-5">


                <select name="category"
                        class="form-select">


                    <option value="">

                        All Categories

                    </option>





                    @if (ViewBag.Categories != null)
                    {


                        foreach (var cat in ViewBag.Categories)
                        {


                            if (ViewBag.SelectedCategory == cat)
                            {


                                <option value="@cat"
                                        selected>


                                    @cat


                                </option>


                            }

                            else
                            {


                                <option value="@cat">


                                    @cat


                                </option>


                            }



                        }


                    }



                </select>


            </div>








            <div class="col-md-2">


                <button type="submit"
                        class="btn sea-btn w-100">


                    Search 🔍


                </button>


            </div>





        </div>


    </form>









    @if (Model == null || !Model.Any())
    {



        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">


                No Available Items


            </h4>





            <p>

                No item matched your search.

            </p>







            <a href="/Item/Browse"
               class="btn btn-outline-secondary">


                Clear Filter


            </a>



        </div>



    }

    else
    {




        <div class="row">





            @foreach (var item in Model)
            {


                <div class="col-md-4 mb-4">





                    <div class="card shadow h-100 item-card">









                        @if (!string.IsNullOrEmpty(item.Image))
                        {


                            <img src="@item.Image"
                                 class="card-img-top"
                                 style="height:220px;object-fit:cover;" />


                        }

                        else
                        {


                            <div class="text-center p-5 bg-light">

                                No Image

                            </div>


                        }









                        <div class="card-body d-flex flex-column">





                            <h5 class="fw-bold">

                                @item.ItemName


                            </h5>








                            <p>


                                <span class="category-badge">

                                    @item.Category


                                </span>


                            </p>








                            <p>


                                <strong>

                                    Price:

                                </strong>



                                <span class="price-text">

                                    ৳ @item.PricePerDay / day

                                </span>



                            </p>








                            <p>


                                <span class="badge bg-success">

                                    Available

                                </span>


                            </p>








                            <div class="mt-auto">


                                <a href="/Item/Details/@item.ItemId"
                                   class="btn sea-btn w-100">


                                    View Details


                                </a>



                            </div>





                        </div>





                    </div>




                </div>


            }




        </div>



    }





</div>