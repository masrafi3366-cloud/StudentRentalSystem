@model StudentRentalSystem.Models.Item


@{
    ViewData["Title"] = "Post New Item";
}





<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-7">


            <div class="card shadow p-4">





                <h2 class="text-center mb-4">

                    Post New Item

                </h2>







                <form method="post"
                      enctype="multipart/form-data">








                    <div class="mb-3">


                        <label class="form-label">

                            Item Name

                        </label>


                        <input asp-for="ItemName"
                               class="form-control"
                               placeholder="Enter item name" />



                        <span asp-validation-for="ItemName"
                              class="text-danger">
                        </span>


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Category

                        </label>



                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Example: Book, Electronics" />


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Description

                        </label>



                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Write item details"></textarea>


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Item Image

                        </label>



                        <input type="file"
                               name="Image"
                               class="form-control" />


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Price Per Day

                        </label>



                        <input asp-for="PricePerDay"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter daily rent price" />



                    </div>









                    <button type="submit"
                            class="btn btn-success w-100">


                        Post Item


                    </button>






                </form>







                <div class="text-center mt-3">


                    <a href="/Item/MyItems"
                       class="btn btn-outline-secondary">


                        Back To My Items


                    </a>


                </div>





            </div>


        </div>


    </div>


</div>





@section Scripts
{

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}