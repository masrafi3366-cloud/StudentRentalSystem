@model StudentRentalSystem.Models.ViewModels.ItemCreateViewModel


@{
    ViewData["Title"] = "Post New Item";
}



<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-7">


            <div class="card shadow p-4">



                <h2 class="text-center mb-4">

                    Post New Item

                </h2>






                @if (TempData["Success"] != null)
                {

                    <div class="alert alert-success text-center">

                        @TempData["Success"]

                    </div>

                }







                @if (TempData["Error"] != null)
                {

                    <div class="alert alert-danger text-center">

                        @TempData["Error"]

                    </div>

                }







                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>







                <form method="post"
                      enctype="multipart/form-data">



                    @Html.AntiForgeryToken()







                    <div class="mb-3">


                        <label class="form-label">

                            Item Name

                        </label>



                        <input asp-for="Item.ItemName"
                               class="form-control"
                               placeholder="Enter item name" />



                        <span asp-validation-for="Item.ItemName"
                              class="text-danger">
                        </span>


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Category

                        </label>



                        <input asp-for="Item.Category"
                               class="form-control"
                               placeholder="Example: Book, Electronics, Furniture" />



                        <span asp-validation-for="Item.Category"
                              class="text-danger">
                        </span>


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Description

                        </label>



                        <textarea asp-for="Item.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Write item details"></textarea>



                        <span asp-validation-for="Item.Description"
                              class="text-danger">
                        </span>


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Item Image

                        </label>



                        <input asp-for="Image"
                               type="file"
                               class="form-control" />


                    </div>









                    <div class="mb-3">


                        <label class="form-label">

                            Price Per Day

                        </label>



                        <input asp-for="Item.PricePerDay"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter rental price" />



                        <span asp-validation-for="Item.PricePerDay"
                              class="text-danger">
                        </span>


                    </div>









                    <!-- PAYMENT METHODS -->


                    <hr />


                    <h4 class="mb-3">

                        Payment Methods 💳

                    </h4>





                    <div id="paymentMethods">


                        <div class="row mb-3">


                            <div class="col-md-5">


                                <input name="PaymentMethods[0].MethodName"
                                       class="form-control"
                                       placeholder="bKash / Nagad / Bank" />


                            </div>




                            <div class="col-md-5">


                                <input name="PaymentMethods[0].AccountNumber"
                                       class="form-control"
                                       placeholder="Account Number" />


                            </div>



                        </div>


                    </div>







                    <button type="button"
                            class="btn btn-outline-success mb-3"
                            onclick="addPaymentMethod()">


                        + Add Method


                    </button>









                    <button type="submit"
                            class="btn btn-success w-100">


                        Post Item


                    </button>





                </form>









                <div class="text-center mt-3">


                    <a href="/Item/MyItems"
                       class="btn btn-outline-secondary">


                        Back To My Items


                    </a>


                </div>





            </div>


        </div>


    </div>


</div>








@section Scripts
{

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }





    <script>


        let paymentIndex = 1;



        function addPaymentMethod() {


            let html = `

                <div class="row mb-3">


                    <div class="col-md-5">


                        <input name="PaymentMethods[${paymentIndex}].MethodName"
                               class="form-control"
                               placeholder="bKash / Nagad / Bank" />


                    </div>




                    <div class="col-md-5">


                        <input name="PaymentMethods[${paymentIndex}].AccountNumber"
                               class="form-control"
                               placeholder="Account Number" />


                    </div>



                </div>

                `;



            document
                .getElementById("paymentMethods")
                .insertAdjacentHTML(
                    "beforeend",
                    html
                );



            paymentIndex++;

        }


    </script>


}