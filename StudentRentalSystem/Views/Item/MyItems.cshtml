@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "My Items";
}



<div class="container mt-4">


    <h2 class="mb-4">
        My Posted Items
    </h2>





    <a href="/Item/Create"
       class="btn btn-success mb-3">

        + Post New Item

    </a>







    @if (Model == null || !Model.Any())
    {



        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Items Found

            </h4>



            <p>

                You have not posted any item yet.

                Start sharing your items with other students.

            </p>





            <a href="/Item/Create"
               class="btn btn-primary">

                Post Your First Item

            </a>



        </div>



    }






    else
    {



        <div class="table-responsive">


            <table class="table table-bordered table-hover shadow">


                <thead class="table-dark">


                    <tr>


                        <th>
                            Image
                        </th>


                        <th>
                            Item Name
                        </th>


                        <th>
                            Category
                        </th>


                        <th>
                            Price / Day
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Created Date
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>






                <tbody>



                    @foreach (var item in Model)
                    {


                        <tr>



                            <td>


                                @if (!string.IsNullOrEmpty(item.Image))
                                {

                                    <img src="@item.Image"
                                         width="80"
                                         height="60"
                                         style="object-fit:cover;"
                                         class="rounded" />

                                }

                                else
                                {

                                    <span>
                                        No Image
                                    </span>

                                }


                            </td>








                            <td>
                                @item.ItemName
                            </td>








                            <td>
                                @item.Category
                            </td>








                            <td>

                                @item.PricePerDay

                            </td>








                            <td>


                                @if (item.AdminApproved)
                                {

                                    <span class="badge bg-success">

                                        Approved

                                    </span>

                                }

                                else
                                {

                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>

                                }


                            </td>








                            <td>

                                @item.CreatedDate.ToShortDateString()

                            </td>








                            <td>


                                <a href="/Item/Details/@item.ItemId"
                                   class="btn btn-primary btn-sm">

                                    View

                                </a>


                            </td>





                        </tr>


                    }



                </tbody>



            </table>


        </div>



    }





</div>