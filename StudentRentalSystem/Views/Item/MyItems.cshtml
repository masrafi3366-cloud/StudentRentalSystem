@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "My Items";
}



<style>


    .sea-btn {
        background-color: #20B2AA;
        border-color: #20B2AA;
        color: white;
    }



        .sea-btn:hover {
            background-color: #178F89;
            border-color: #178F89;
            color: white;
        }



    .page-title {
        color: #20B2AA;
        font-weight: 700;
    }



    .table thead th {
        background-color: #20B2AA;
        color: white;
    }



    .item-image {
        width: 90px;
        height: 70px;
        object-fit: cover;
        border-radius: 10px;
    }



    .action-btn {
        margin-bottom: 5px;
    }

</style>








<div class="container mt-4">





    @if (TempData["Success"] != null)
    {

        <div class="alert alert-success shadow">

            @TempData["Success"]

        </div>

    }







    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger shadow">

            @TempData["Error"]

        </div>

    }








    <div class="d-flex justify-content-between align-items-center mb-4">



        <h2 class="page-title">

            My Posted Items 📦

        </h2>






        <a href="/Item/Create"
           class="btn sea-btn">


            + Post New Item


        </a>



    </div>









    @if (Model == null || !Model.Any())
    {



        <div class="card shadow p-5 text-center">



            <h4 class="text-muted">

                No Items Found

            </h4>





            <p>

                You have not posted any item yet.

            </p>






            <a href="/Item/Create"
               class="btn sea-btn">


                Post Your First Item


            </a>



        </div>



    }

    else
    {



        <div class="card shadow">


            <div class="card-body">



                <div class="table-responsive">



                    <table class="table table-bordered table-hover align-middle">





                        <thead>


                            <tr>


                                <th>
                                    Image
                                </th>


                                <th>
                                    Item Name
                                </th>


                                <th>
                                    Category
                                </th>


                                <th>
                                    Price / Day
                                </th>


                                <th>
                                    Status
                                </th>


                                <th>
                                    Created Date
                                </th>


                                <th>
                                    Action
                                </th>


                            </tr>


                        </thead>







                        <tbody>



                            @foreach (var item in Model)
                            {


                                <tr>




                                    <td>


                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {


                                            <img src="@item.Image"
                                                 class="item-image shadow" />


                                        }

                                        else
                                        {


                                            <span class="text-muted">

                                                No Image

                                            </span>


                                        }


                                    </td>









                                    <td>


                                        <strong>

                                            @item.ItemName

                                        </strong>



                                        <br />


                                        <small class="text-muted">

                                            ID: @item.ItemId

                                        </small>


                                    </td>









                                    <td>


                                        <span class="badge"
                                              style="background:#20B2AA;">


                                            @item.Category


                                        </span>


                                    </td>









                                    <td>


                                        <strong>

                                            ৳ @item.PricePerDay

                                        </strong>


                                        / day


                                    </td>









                                    <td>



                                        @if (item.IsRented)
                                        {


                                            <span class="badge bg-danger">

                                                Rented

                                            </span>


                                        }

                                        else if (item.AdminApproved)
                                        {


                                            <span class="badge bg-success">

                                                Available

                                            </span>


                                        }

                                        else
                                        {


                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>


                                        }


                                    </td>









                                    <td>

                                        @item.CreatedDate.ToShortDateString()


                                    </td>









                                    <td>



                                        <a href="/Item/Details/@item.ItemId"
                                           class="btn btn-primary btn-sm action-btn">


                                            View


                                        </a>







                                        <a href="/Item/Edit/@item.ItemId"
                                           class="btn btn-warning btn-sm action-btn">


                                            Edit


                                        </a>









                                        @if (item.IsRented)
                                        {


                                            <button class="btn btn-secondary btn-sm"
                                                    disabled>


                                                Delete


                                            </button>


                                        }

                                        else
                                        {


                                            <a href="/Item/Delete/@item.ItemId"
                                               class="btn btn-danger btn-sm"
                                               onclick="return confirm('Are you sure you want to delete this item?');">


                                                Delete


                                            </a>


                                        }




                                    </td>





                                </tr>


                            }



                        </tbody>



                    </table>



                </div>



            </div>


        </div>



    }





</div>