@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "My Items";
}






<div class="container mt-4">





    @if (TempData["Success"] != null)
    {

        <div class="alert alert-success shadow">

            @TempData["Success"]

        </div>

    }







    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger shadow">

            @TempData["Error"]

        </div>

    }








    <h2 class="mb-4">

        My Posted Items 📦

    </h2>








    <a href="/Item/Create"
       class="btn btn-success mb-3">


        + Post New Item


    </a>









    @if (Model == null || !Model.Any())
    {



        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Items Found

            </h4>



            <p>

                You have not posted any item yet.

            </p>





            <a href="/Item/Create"
               class="btn btn-primary">


                Post Your First Item


            </a>



        </div>



    }

    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow align-middle">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Image
                        </th>


                        <th>
                            Item Name
                        </th>


                        <th>
                            Category
                        </th>


                        <th>
                            Price / Day
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Created Date
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>







                <tbody>



                    @foreach (var item in Model)
                    {


                        <tr>



                            <td>


                                @if (!string.IsNullOrEmpty(item.Image))
                                {


                                    <img src="@item.Image"
                                         width="90"
                                         height="70"
                                         class="rounded shadow"
                                         style="object-fit:cover;" />


                                }
                                else
                                {


                                    <span class="text-muted">

                                        No Image

                                    </span>


                                }



                            </td>








                            <td>


                                <strong>

                                    @item.ItemName

                                </strong>



                                <br />


                                <small class="text-muted">

                                    ID: @item.ItemId

                                </small>


                            </td>








                            <td>


                                <span class="badge bg-info text-dark">

                                    @item.Category

                                </span>


                            </td>








                            <td>

                                ৳ @item.PricePerDay / day


                            </td>








                            <td>


                                @if (item.IsRented)
                                {


                                    <span class="badge bg-danger">

                                        Rented

                                    </span>


                                }

                                else if (item.AdminApproved)
                                {


                                    <span class="badge bg-success">

                                        Available

                                    </span>


                                }

                                else
                                {


                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>


                                }



                            </td>








                            <td>

                                @item.CreatedDate.ToShortDateString()

                            </td>








                            <td>




                                <a href="/Item/Details/@item.ItemId"
                                   class="btn btn-primary btn-sm mb-1">


                                    View


                                </a>








                                <a href="/Item/Edit/@item.ItemId"
                                   class="btn btn-warning btn-sm mb-1">


                                    Edit


                                </a>








                                @if (item.IsRented)
                                {


                                    <button class="btn btn-secondary btn-sm"
                                            disabled>


                                        Delete


                                    </button>


                                }

                                else
                                {


                                    <a href="/Item/Delete/@item.ItemId"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this item?');">


                                        Delete


                                    </a>


                                }




                            </td>





                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>