@model StudentRentalSystem.Models.Rental


<h2>
    Return Completed
</h2>


<hr />


<p>
    Rental ID:

    @Model.RentalId

</p>



<p>
    Item ID:

    @Model.ItemId

</p>



<p>
    Status:

    @Model.Status

</p>



@if (Model.Status == "Completed")
{

    <p>
        Item returned on time.
        No extra charge.
    </p>

}
else
{

    <p>
        Late return detected.
        Extra charge will be applied.
    </p>

}


<br />


<a href="/Account/Dashboard">
    Back Dashboard
</a>