@model StudentRentalSystem.Models.ViewModels.RentalConfirmationViewModel


@{
    ViewData["Title"] = "Rental Confirmation";
}






<div class="container mt-5">





    <div class="row justify-content-center">


        <div class="col-md-7">





            <div class="card shadow p-4 text-center">





                <h2 class="text-success mb-3">

                    Rental Confirmed Successfully 🎉

                </h2>







                <p class="text-muted">

                    Your rental request has been created.

                </p>








                <hr />









                <div class="text-start">





                    <p>

                        <strong>
                            Rental ID:
                        </strong>

                        @Model.RentalId


                    </p>









                    <p>

                        <strong>
                            Item ID:
                        </strong>

                        @Model.ItemId


                    </p>









                    <p>

                        <strong>
                            Start Date:
                        </strong>


                        @Model.StartDate.ToShortDateString()


                    </p>









                    <p>

                        <strong>
                            End Date:
                        </strong>


                        @Model.EndDate.ToShortDateString()


                    </p>









                    <p>

                        <strong>
                            Rental Duration:
                        </strong>


                        @Model.RentalDays Days


                    </p>









                    <p>

                        <strong>
                            Total Amount:
                        </strong>


                        <span class="text-success fw-bold">

                            ৳ @Model.TotalAmount

                        </span>


                    </p>









                    <p>

                        <strong>
                            Status:
                        </strong>




                        @if (Model.Status == "Confirmed")
                        {

                            <span class="badge bg-success">

                                Confirmed

                            </span>


                        }

                        else if (Model.Status == "Returned")
                        {

                            <span class="badge bg-secondary">

                                Returned

                            </span>


                        }

                        else
                        {

                            <span class="badge bg-warning text-dark">

                                @Model.Status

                            </span>


                        }



                    </p>





                </div>









                <hr />









                <div class="d-grid gap-2">





                    <a href="/Payment/Create/@Model.RentalId"
                       class="btn btn-success">


                        Proceed To Payment 💳


                    </a>








                    <a href="/Rental/MyRentals"
                       class="btn btn-outline-primary">


                        View My Rentals


                    </a>








                    <a href="/Item/Browse"
                       class="btn btn-outline-secondary">


                        Browse More Items


                    </a>





                </div>







            </div>





        </div>





    </div>







</div>