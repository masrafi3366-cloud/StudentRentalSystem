@model IEnumerable<StudentRentalSystem.Models.Rental>



@{
    ViewData["Title"] = "My Rentals";
}






<div class="container mt-4">





    <h2 class="mb-4">

        My Rented Items 🔄

    </h2>








    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Rental Found

            </h4>



            <p>

                You have not rented any item yet.

            </p>





            <a href="/Item/Browse"
               class="btn btn-primary">


                Browse Items


            </a>



        </div>


    }







    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Item
                        </th>


                        <th>
                            Start Date
                        </th>


                        <th>
                            End Date
                        </th>


                        <th>
                            Return Date
                        </th>


                        <th>
                            Days
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>








                <tbody>



                    @foreach (var rental in Model)
                    {


                        <tr>


                            <td>

                                @rental.RentalId

                            </td>







                            <td>


                                <a href="/Item/Details/@rental.ItemId"
                                   class="btn btn-outline-primary btn-sm">


                                    View Item


                                </a>


                            </td>








                            <td>

                                @rental.StartDate.ToShortDateString()

                            </td>








                            <td>

                                @rental.EndDate.ToShortDateString()

                            </td>








                            <td>


                                @if (rental.ReturnDate != null)
                                {

                                    @rental.ReturnDate.Value.ToShortDateString()

                                }
                                else
                                {

                                    <span class="text-muted">

                                        Not Returned

                                    </span>

                                }



                            </td>








                            <td>

                                @rental.RentalDays

                            </td>








                            <td>

                                ৳ @rental.TotalAmount

                            </td>








                            <td>




                                @if (rental.Status == "Confirmed")
                                {


                                    <span class="badge bg-success">

                                        Rented

                                    </span>


                                }

                                else if (rental.Status == "Pending")
                                {


                                    <span class="badge bg-warning text-dark">

                                        Pending Payment

                                    </span>


                                }

                                else if (rental.Status == "Returned")
                                {


                                    <span class="badge bg-secondary">

                                        Returned

                                    </span>


                                }

                                else if (rental.Status == "Late")
                                {


                                    <span class="badge bg-danger">

                                        Late Return

                                    </span>


                                }

                                else
                                {


                                    <span class="badge bg-info">

                                        @rental.Status

                                    </span>


                                }



                            </td>








                            <td>



                                @if (!rental.IsReturned &&
                                    rental.Status == "Confirmed")
                                {


                                    <a href="/Rental/ReturnItem/@rental.RentalId"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to return this item?');">


                                        Return Item


                                    </a>



                                }

                                else if (rental.IsReturned)
                                {


                                    <span class="badge bg-secondary">

                                        Completed

                                    </span>


                                }

                                else
                                {


                                    <span class="text-muted">

                                        Waiting

                                    </span>


                                }



                            </td>






                        </tr>


                    }



                </tbody>



            </table>



        </div>


    }





</div>