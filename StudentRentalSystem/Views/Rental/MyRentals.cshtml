@model IEnumerable<StudentRentalSystem.Models.Rental>



@{
    ViewData["Title"] = "My Rentals";
}




<div class="container mt-4">


    <h2 class="mb-4">
        My Rental History
    </h2>







    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">



            <h4 class="text-muted">

                No Rental Found

            </h4>



            <p>

                You have not rented any item yet.

                Browse available items and start renting.

            </p>




            <a href="/Item/Browse"
               class="btn btn-primary">

                Browse Items

            </a>



        </div>



    }







    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Start Date
                        </th>


                        <th>
                            End Date
                        </th>


                        <th>
                            Days
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Status
                        </th>


                    </tr>


                </thead>







                <tbody>



                    @foreach (var rental in Model)
                    {


                        <tr>


                            <td>
                                @rental.RentalId
                            </td>



                            <td>
                                @rental.StartDate.ToShortDateString()
                            </td>



                            <td>
                                @rental.EndDate.ToShortDateString()
                            </td>



                            <td>
                                @rental.RentalDays
                            </td>



                            <td>
                                @rental.TotalAmount
                            </td>







                            <td>



                                @if (rental.Status == "Approved")
                                {

                                    <span class="badge bg-success">

                                        Approved

                                    </span>

                                }

                                else if (rental.Status == "Pending")
                                {

                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>

                                }

                                else if (rental.Status == "Late")
                                {

                                    <span class="badge bg-danger">

                                        Late

                                    </span>

                                }

                                else
                                {

                                    <span class="badge bg-secondary">

                                        @rental.Status

                                    </span>

                                }



                            </td>



                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>