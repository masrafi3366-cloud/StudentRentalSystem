@model IEnumerable<StudentRentalSystem.Models.Payment>


@{
    ViewData["Title"] = "My Payments";
}





<div class="container mt-4">





    @if (TempData["Success"] != null)
    {

        <div class="alert alert-success shadow">

            @TempData["Success"]

        </div>

    }







    <h2 class="mb-4">

        My Payment History 💳

    </h2>









    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Payment Found

            </h4>



            <p>

                You have not completed any payment yet.

            </p>





            <a href="/Item/Browse"
               class="btn btn-primary">


                Browse Items


            </a>



        </div>


    }

    else
    {




        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow align-middle">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Payment ID
                        </th>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Transaction ID
                        </th>


                        <th>
                            Payment Date
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>








                <tbody>



                    @foreach (var payment in Model)
                    {


                        <tr>


                            <td>

                                @payment.PaymentId

                            </td>








                            <td>

                                @payment.RentalId

                            </td>








                            <td>


                                <strong class="text-success">

                                    ৳ @payment.Amount

                                </strong>


                            </td>








                            <td>


                                <span class="text-muted">

                                    @payment.TransactionId

                                </span>


                            </td>








                            <td>

                                @payment.PaymentDate.ToString("dd MMM yyyy")


                            </td>








                            <td>


                                @if (payment.PaymentStatus == "Completed")
                                {


                                    <span class="badge bg-success">

                                        Paid

                                    </span>


                                }
                                else
                                {


                                    <span class="badge bg-warning text-dark">

                                        @payment.PaymentStatus

                                    </span>


                                }



                            </td>








                            <td>


                                <a href="/Payment/Success/@payment.PaymentId"
                                   class="btn btn-primary btn-sm">


                                    Receipt


                                </a>


                            </td>





                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>