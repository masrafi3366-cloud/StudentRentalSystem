@model IEnumerable<StudentRentalSystem.Models.Payment>


@{
    ViewData["Title"] = "My Payments";
}



<div class="container mt-4">


    <h2 class="mb-4">
        Payment History
    </h2>







    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">



            <h4 class="text-muted">

                No Payment History

            </h4>




            <p>

                You don't have any payment records yet.

                Your payment details will appear here after completing a rental payment.

            </p>





            <a href="/Rental/MyRentals"
               class="btn btn-primary">

                View My Rentals

            </a>



        </div>



    }







    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Payment ID
                        </th>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Payment Date
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Transaction ID
                        </th>


                    </tr>


                </thead>








                <tbody>



                    @foreach (var payment in Model)
                    {


                        <tr>


                            <td>
                                @payment.PaymentId
                            </td>



                            <td>
                                @payment.RentalId
                            </td>



                            <td>
                                @payment.Amount
                            </td>



                            <td>
                                @payment.PaymentDate.ToShortDateString()
                            </td>







                            <td>


                                @if (payment.PaymentStatus == "Completed")
                                {

                                    <span class="badge bg-success">

                                        Paid

                                    </span>

                                }

                                else
                                {

                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>

                                }


                            </td>







                            <td>
                                @payment.TransactionId
                            </td>



                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>