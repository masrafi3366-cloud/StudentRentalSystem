@model IEnumerable<StudentRentalSystem.Models.Payment>


@{
    ViewData["Title"] = "My Payments";
}





<div class="container mt-4">


    <h2 class="mb-4">

        My Payment History

    </h2>








    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Payment Found

            </h4>



            <p>

                You have not completed any payment yet.

            </p>




            <a href="/Item/Browse"
               class="btn btn-primary">


                Browse Items


            </a>



        </div>


    }






    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Payment ID
                        </th>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Transaction ID
                        </th>


                        <th>
                            Date
                        </th>


                        <th>
                            Status
                        </th>


                    </tr>


                </thead>








                <tbody>



                    @foreach (var payment in Model)
                    {


                        <tr>


                            <td>

                                @payment.PaymentId

                            </td>





                            <td>

                                @payment.RentalId

                            </td>






                            <td>

                                ৳ @payment.Amount

                            </td>






                            <td>

                                @payment.TransactionId

                            </td>







                            <td>

                                @payment.PaymentDate.ToShortDateString()

                            </td>







                            <td>



                                @if (payment.PaymentStatus == "Completed")
                                {


                                    <span class="badge bg-success">

                                        Paid

                                    </span>


                                }

                                else
                                {


                                    <span class="badge bg-warning text-dark">

                                        @payment.PaymentStatus

                                    </span>


                                }



                            </td>




                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>