@model StudentRentalSystem.Models.Rental


@{
    ViewData["Title"] = "Payment";
}






<div class="container mt-5">






    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger shadow">

            @TempData["Error"]

        </div>

    }









    <div class="row justify-content-center">


        <div class="col-md-6">





            <div class="card shadow p-4">





                <h2 class="text-center text-primary mb-4">

                    Complete Payment 💳

                </h2>







                <div class="card bg-light mb-4">


                    <div class="card-body text-center">


                        <h5>

                            Total Rental Amount

                        </h5>




                        <h2 class="text-success fw-bold">

                            ৳ @Model.TotalAmount

                        </h2>



                    </div>


                </div>









                <div class="mb-4">



                    <h5 class="mb-3">

                        Rental Details

                    </h5>







                    <p>

                        <strong>
                            Rental ID:
                        </strong>

                        @Model.RentalId

                    </p>








                    <p>

                        <strong>
                            Rental Days:
                        </strong>

                        @Model.RentalDays Days

                    </p>








                    <p>

                        <strong>
                            Start Date:
                        </strong>

                        @Model.StartDate.ToShortDateString()

                    </p>








                    <p>

                        <strong>
                            End Date:
                        </strong>

                        @Model.EndDate.ToShortDateString()

                    </p>





                </div>








                <hr />








                <form method="post">


                    @Html.AntiForgeryToken()






                    <input type="hidden"
                           name="RentalId"
                           value="@Model.RentalId" />








                    <div class="mb-3">


                        <label class="form-label fw-bold">

                            Transaction ID

                        </label>




                        <input type="text"
                               name="TransactionId"
                               class="form-control"
                               placeholder="Enter payment transaction ID"
                               required />



                        <small class="text-muted">

                            Enter your mobile banking transaction ID.

                        </small>


                    </div>








                    <button type="submit"
                            class="btn btn-success w-100">


                        Confirm Payment ✅


                    </button>





                </form>









                <a href="/Rental/MyRentals"
                   class="btn btn-outline-secondary w-100 mt-3">


                    Back To Rentals


                </a>







            </div>




        </div>




    </div>






</div>