@model StudentRentalSystem.Models.Payment


@{
    ViewData["Title"] = "Payment Successful";
}





<div class="container mt-5">





    <div class="row justify-content-center">


        <div class="col-md-6">





            <div class="card shadow p-4 text-center">





                <div class="mb-4">


                    <h2 class="text-success">

                        Payment Successful 🎉

                    </h2>



                    <p class="text-muted">

                        Your payment has been completed successfully.

                    </p>


                </div>







                <hr />








                <div class="alert alert-success">


                    <h4>

                        ৳ @Model.Amount

                    </h4>


                    <p class="mb-0">

                        Payment Completed

                    </p>


                </div>









                <div class="text-start">





                    <p>

                        <strong>
                            Payment ID:
                        </strong>


                        @Model.PaymentId


                    </p>








                    <p>

                        <strong>
                            Rental ID:
                        </strong>


                        @Model.RentalId


                    </p>








                    <p>

                        <strong>
                            Payment Method:
                        </strong>


                        @Model.PaymentMethod


                    </p>








                    <p>

                        <strong>
                            Transaction ID:
                        </strong>


                        @Model.TransactionId


                    </p>








                    <p>

                        <strong>
                            Payment Details:
                        </strong>


                        @Model.PaymentDetails


                    </p>








                    <p>

                        <strong>
                            Payment Date:
                        </strong>


                        @Model.PaymentDate.ToString("dd MMM yyyy")


                    </p>








                    <p>

                        <strong>
                            Status:
                        </strong>




                        @if (Model.PaymentStatus == "Completed")
                        {

                            <span class="badge bg-success">

                                Paid

                            </span>

                        }
                        else
                        {

                            <span class="badge bg-warning text-dark">

                                @Model.PaymentStatus

                            </span>

                        }



                    </p>






                    @if (ViewBag.Rental != null)
                    {

                        <hr />


                        <h5>

                            Rental Information

                        </h5>



                        <p>

                            <strong>
                                Rental Days:
                            </strong>

                            @ViewBag.Rental.RentalDays Days

                        </p>




                        <p>

                            <strong>
                                Total Rental Amount:
                            </strong>

                            ৳ @ViewBag.Rental.TotalAmount

                        </p>


                    }




                </div>









                <hr />









                <a href="/Account/Dashboard"
                   class="btn btn-primary w-100 mb-2">


                    Go Dashboard


                </a>








                <a href="/Payment/MyPayments"
                   class="btn btn-outline-success w-100 mb-2">


                    View My Payments


                </a>








                <a href="/Item/Browse"
                   class="btn btn-outline-secondary w-100">


                    Browse More Items


                </a>






            </div>


        </div>


    </div>


</div>