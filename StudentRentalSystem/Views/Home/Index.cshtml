@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "Home";
}



<div class="container mt-4">



    <!-- HERO SECTION -->

    <div class="card shadow p-5 text-center mb-5">


        <h2 class="fw-bold">

            Welcome
            <span style="color:#20B2AA;">

                @(ViewBag.StudentName ?? "Student")

            </span>
            to

        </h2>





        <h1 class="fw-bold mt-2">

            Student Rental System 👋

        </h1>






        <p class="fs-6 text-muted mt-3">

            Rent, share and manage items easily
            with other students through a secure platform.

        </p>







        <div class="mt-4">


            <a href="/Item/Create"
               class="btn btn-success btn-lg me-2">


                📦 Post Items


            </a>







            <a href="/Item/Browse"
               class="btn btn-primary btn-lg">


                🔍 Browse Items


            </a>



        </div>


    </div>









    <!-- FEATURES -->


    <div class="row text-center mb-5">





        <div class="col-md-4 mb-3">


            <div class="card shadow p-4 h-100">


                <h4>

                    📦 Post Items

                </h4>


                <p>

                    Share unused items with other students
                    and earn through rentals.

                </p>


            </div>


        </div>









        <div class="col-md-4 mb-3">


            <div class="card shadow p-4 h-100">


                <h4>

                    🛒 Rent Items

                </h4>


                <p>

                    Find and rent useful items
                    from other students easily.

                </p>


            </div>


        </div>









        <div class="col-md-4 mb-3">


            <div class="card shadow p-4 h-100">


                <h4>

                    🔐 Secure System

                </h4>


                <p>

                    Manage rentals and payments
                    through a secure system.

                </p>


            </div>


        </div>



    </div>









    <!-- FEATURED ITEMS -->


    <h2 class="text-center mb-4">

        Featured Items 🛍️

    </h2>







    <div class="row">



        @if (Model != null && Model.Any())
        {


            foreach (var item in Model)
            {


                <div class="col-md-3 mb-4">


                    <div class="card shadow h-100">





                        @if (!string.IsNullOrEmpty(item.Image))
                        {


                            <img src="@item.Image"
                                 class="card-img-top"
                                 style="height:180px; object-fit:cover;" />


                        }

                        else
                        {


                            <div class="bg-secondary text-white text-center p-5">

                                No Image

                            </div>


                        }







                        <div class="card-body d-flex flex-column">


                            <h5 class="fw-bold">

                                @item.ItemName

                            </h5>







                            <span class="badge bg-info text-dark">

                                @item.Category

                            </span>







                            <p class="mt-3">

                                ৳ @item.PricePerDay / day

                            </p>







                            <span class="badge bg-success mb-3">

                                Available

                            </span>








                            <div class="mt-auto">


                                <a href="/Item/Details/@item.ItemId"
                                   class="btn btn-primary w-100">


                                    View Details


                                </a>


                            </div>



                        </div>



                    </div>


                </div>


            }


        }

        else
        {


            <div class="text-center text-muted">

                No items available currently.

            </div>


        }



    </div>









    <!-- BROWSE MORE -->


    <div class="text-center mt-4 mb-5">


        <a href="/Item/Browse"
           class="btn btn-outline-primary btn-lg">


            Browse More Items


        </a>



    </div>





</div>