@{
    ViewData["Title"] = "Home";
}


<div class="container mt-5">


    <div class="p-5 mb-4 bg-light rounded-3">


        <div class="container-fluid py-5">


            <h1 class="display-4 fw-bold">
                Student Rental System
            </h1>


            <p class="fs-4">
                Rent, Share and Manage Items Easily
                Among Students.
            </p>


            <a href="/Item/Browse"
               class="btn btn-primary btn-lg">

                Browse Items

            </a>



            <a href="/Account/Register"
               class="btn btn-success btn-lg ms-2">

                Register

            </a>

            
            
            <a href="/Account/Login"
               class="btn btn-dark btn-lg ms-2">

                Login

            </a>


        </div>


    </div>





    <div class="row text-center">


        <div class="col-md-4">


            <div class="card shadow p-3">


                <h3>
                    Post Items
                </h3>


                <p>
                    Students can post their
                    unused items for rent.
                </p>


            </div>


        </div>





        <div class="col-md-4">


            <div class="card shadow p-3">


                <h3>
                    Rent Items
                </h3>


                <p>
                    Find useful items from
                    other students.
                </p>


            </div>


        </div>






        <div class="col-md-4">


            <div class="card shadow p-3">


                <h3>
                    Secure System
                </h3>


                <p>
                    Admin verification and
                    payment tracking.
                </p>


            </div>


        </div>


    </div>



</div>