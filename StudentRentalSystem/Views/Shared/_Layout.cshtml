<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        Student Rental System
    </title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">





    <style>


            :root {
                --sea-green: #20B2AA;
                --sea-green-dark: #178F89;
                --light-bg: #f5ffff;
            }






            html,
            body {
                height: 100%;
            }







            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background-color: var(--light-bg);
            }







            main {
                flex: 1;
            }








            .navbar {
                background-color: var(--sea-green) !important;
            }








            .navbar-brand {
                color: white !important;
                font-size: 22px;
            }








            .nav-link {
                color: white !important;
                margin-left: 8px;
                transition: .3s;
            }








                .nav-link:hover {
                    color: #e0ffff !important;
                    transform: translateY(-2px);
                }








            .card {
                border-radius: 15px;
                border: none;
                box-shadow: 0 5px 15px rgba(0,0,0,.08);
            }








            .btn {
                border-radius: 8px;
            }








            .btn-primary,
            .btn-success {
                background-color: var(--sea-green);
                border-color: var(--sea-green);
            }








                .btn-primary:hover,
                .btn-success:hover {
                    background-color: var(--sea-green-dark);
                    border-color: var(--sea-green-dark);
                }








            .table thead {
                background-color: var(--sea-green);
                color: white;
            }








            footer {
                margin-top: auto;
                width: 100%;
                background-color: var(--sea-green);
            }








            .badge {
                padding: 8px;
                border-radius: 8px;
            }

    </style>



</head>







<body>





    <nav class="navbar navbar-expand-lg shadow">


        <div class="container">



            <a class="navbar-brand fw-bold"
               href="/Account/Dashboard">


                Student Rental System


            </a>







            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu">


                <span class="navbar-toggler-icon"></span>


            </button>







            <div class="collapse navbar-collapse"
                 id="navbarMenu">



                <ul class="navbar-nav ms-auto">






                    <li class="nav-item">


                        <a class="nav-link"
                           href="/Item/Browse">


                            Browse Items


                        </a>


                    </li>








                    @if (Context.Session.GetString("Admin") != null)
                    {


                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Admin/Dashboard">


                                Admin Dashboard


                            </a>


                        </li>







                        <li class="nav-item">


                            <a class="nav-link"
                               asp-area="Admin"
                               asp-controller="Admin"
                               asp-action="Logout">


                                Logout


                            </a>


                        </li>


                    }







                    else if (Context.Session.GetInt32("StudentId") != null)
                    {



                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Dashboard">


                                Dashboard


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Item/MyItems">


                                My Items


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Rental/MyRentals">


                                My Rentals


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Payment/MyPayments">


                                Payments


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/ExtraCharge/MyCharges">


                                Charges


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Profile">


                                Profile


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Logout">


                                Logout


                            </a>


                        </li>


                    }







                    else
                    {


                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Login">


                                Login


                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Register">


                                Register


                            </a>


                        </li>


                    }





                </ul>



            </div>



        </div>


    </nav>









    <main class="flex-grow-1">


        <div class="container mt-4">


            @RenderBody()


        </div>


    </main>









    <footer class="text-white text-center p-4">


        <h5>

            Student Rental System

        </h5>



        <p>

            Rent • Share • Manage

        </p>



        <small>

            © 2026 Student Rental System

        </small>



    </footer>









    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">

    </script>





    @await RenderSectionAsync(
        "Scripts",
        required: false
    )



</body>


</html>