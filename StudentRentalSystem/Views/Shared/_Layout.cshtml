<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <title>
        Student Rental System
    </title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">



    <style>


            .card {
                border-radius: 15px;
            }


            .btn {
                border-radius: 8px;
            }


            footer {
                margin-top: 50px;
            }

    </style>


</head>






<body>



    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">


        <div class="container">



            <a class="navbar-brand fw-bold"
               href="/">


                Student Rental System


            </a>







            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu">


                <span class="navbar-toggler-icon"></span>


            </button>







            <div class="collapse navbar-collapse"
                 id="navbarMenu">





                <ul class="navbar-nav ms-auto">







                    <li class="nav-item">

                        <a class="nav-link"
                           href="/Item/Browse">

                            Browse Items

                        </a>

                    </li>








                    @if (Context.Session.GetInt32("StudentId") != null)
                    {



                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Account/Dashboard">

                                Dashboard

                            </a>

                        </li>







                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Rental/MyRentals">

                                My Rentals

                            </a>

                        </li>








                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Payment/MyPayments">

                                My Payments

                            </a>

                        </li>








                        <li class="nav-item">

                            <a class="nav-link"
                               href="/Account/Profile">

                                Profile

                            </a>

                        </li>








                        <li class="nav-item">

                            <a class="nav-link text-danger"
                               href="/Account/Logout">

                                Logout

                            </a>

                        </li>



                    }

                    else
                    {



                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Login">

                                Login

                            </a>


                        </li>








                        <li class="nav-item">


                            <a class="nav-link"
                               href="/Account/Register">

                                Register

                            </a>


                        </li>


                    }







                </ul>





            </div>




        </div>


    </nav>









    <div class="container mt-4">


        @RenderBody()


    </div>








    <footer class="bg-dark text-white text-center p-4">


        <h5>
            Student Rental System
        </h5>


        <p>
            Rent • Share • Manage
        </p>


        <small>
            © 2026 Student Rental System
        </small>


    </footer>








    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>




    @await RenderSectionAsync(
    "Scripts",
    required: false
    )



</body>


</html>