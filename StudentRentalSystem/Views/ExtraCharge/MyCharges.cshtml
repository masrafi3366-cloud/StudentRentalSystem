@model IEnumerable<StudentRentalSystem.Models.ExtraCharge>


@{
    ViewData["Title"] = "My Charges";
}





<div class="container mt-4">





    @if (TempData["Success"] != null)
    {

        <div class="alert alert-success shadow">

            @TempData["Success"]

        </div>

    }








    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger shadow">

            @TempData["Error"]

        </div>

    }








    <h2 class="mb-4">

        My Extra Charges 💰

    </h2>









    @if (Model == null || !Model.Any())
    {


        <div class="card shadow p-5 text-center">


            <h4 class="text-muted">

                No Extra Charges

            </h4>





            <p>

                You don't have any late return charges.

            </p>







            <a href="/Rental/MyRentals"
               class="btn btn-primary">


                View My Rentals


            </a>



        </div>


    }

    else
    {



        <div class="table-responsive">



            <table class="table table-bordered table-hover shadow align-middle">



                <thead class="table-dark">


                    <tr>


                        <th>
                            Charge ID
                        </th>


                        <th>
                            Rental ID
                        </th>


                        <th>
                            Late Days
                        </th>


                        <th>
                            Amount
                        </th>


                        <th>
                            Status
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>








                <tbody>



                    @foreach (var charge in Model)
                    {


                        <tr>



                            <td>

                                @charge.ChargeId

                            </td>








                            <td>

                                @charge.RentalId

                            </td>








                            <td>

                                @charge.LateDays Days

                            </td>








                            <td>


                                <strong class="text-danger">

                                    ৳ @charge.Amount

                                </strong>


                            </td>








                            <td>



                                @if (charge.PaidStatus)
                                {


                                    <span class="badge bg-success">

                                        Paid

                                    </span>


                                }
                                else
                                {


                                    <span class="badge bg-danger">

                                        Unpaid

                                    </span>


                                }



                            </td>








                            <td>



                                @if (!charge.PaidStatus)
                                {


                                    <a href="/ExtraCharge/Pay/@charge.ChargeId"
                                       class="btn btn-success btn-sm">


                                        Pay Now 💳


                                    </a>


                                }
                                else
                                {


                                    <span class="badge bg-success">

                                        Completed

                                    </span>


                                }



                            </td>





                        </tr>


                    }



                </tbody>



            </table>



        </div>



    }





</div>