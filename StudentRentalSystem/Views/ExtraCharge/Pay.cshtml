@model StudentRentalSystem.Models.ExtraCharge


@{
    ViewData["Title"] = "Pay Extra Charge";
}





<div class="container mt-5">





    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger shadow">

            @TempData["Error"]

        </div>

    }








    <div class="row justify-content-center">


        <div class="col-md-6">





            <div class="card shadow p-4 text-center">





                <h2 class="text-danger mb-4">

                    Pay Extra Charge 💰

                </h2>








                <div class="alert alert-warning">


                    <h5>

                        Late Return Charge

                    </h5>



                    <h2 class="text-danger">

                        ৳ @Model.Amount

                    </h2>


                </div>








                <hr />








                <div class="text-start">



                    <p>

                        <strong>
                            Charge ID:
                        </strong>


                        @Model.ChargeId


                    </p>








                    <p>

                        <strong>
                            Rental ID:
                        </strong>


                        @Model.RentalId


                    </p>








                    <p>

                        <strong>
                            Late Days:
                        </strong>


                        @Model.LateDays Days


                    </p>







                    <p>

                        <strong>
                            Status:
                        </strong>




                        @if (Model.PaidStatus)
                        {

                            <span class="badge bg-success">

                                Paid

                            </span>

                        }
                        else
                        {

                            <span class="badge bg-danger">

                                Unpaid

                            </span>

                        }



                    </p>





                </div>









                <hr />








                @if (!Model.PaidStatus)
                {


                    <form method="post"
                          action="/ExtraCharge/Pay">



                        @Html.AntiForgeryToken()






                        <input type="hidden"
                               name="ChargeId"
                               value="@Model.ChargeId" />








                        <button type="submit"
                                class="btn btn-success w-100">


                            Confirm Payment ✅


                        </button>




                    </form>


                }
                else
                {


                    <button class="btn btn-secondary w-100"
                            disabled>


                        Already Paid


                    </button>


                }









                <a href="/ExtraCharge/MyCharges"
                   class="btn btn-outline-primary w-100 mt-3">


                    Back To Charges


                </a>







            </div>





        </div>





    </div>







</div>