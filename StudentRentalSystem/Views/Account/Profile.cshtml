@model StudentRentalSystem.Models.Student


@{
    ViewData["Title"] = "My Profile";
}



<style>

    .profile-title {
        color: #20B2AA;
        font-weight: 700;
    }


    .profile-section-title {
        color: #178F89;
        font-weight: 600;
    }


    .profile-info p {
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eeeeee;
    }


    .activity-card {
        border: 1px solid #20B2AA !important;
        transition: 0.3s;
    }


        .activity-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(32, 178, 170, 0.20);
        }


    .activity-number {
        color: #20B2AA;
        font-weight: bold;
        font-size: 26px;
    }


    .sea-btn {
        background-color: #20B2AA;
        border-color: #20B2AA;
        color: white;
    }


        .sea-btn:hover {
            background-color: #178F89;
            border-color: #178F89;
            color: white;
        }


    .sea-outline-btn {
        border-color: #20B2AA;
        color: #20B2AA;
    }


        .sea-outline-btn:hover {
            background-color: #20B2AA;
            color: white;
        }

</style>






<div class="container mt-4">





    <div class="text-center mb-4">


        <h2 class="profile-title">

            My Profile 👤

        </h2>


        <p class="text-muted">

            View and manage your student account information.

        </p>


    </div>








    <div class="row">





        <!-- PERSONAL INFORMATION -->


        <div class="col-md-6 mb-4">


            <div class="card shadow h-100">


                <div class="card-body p-4 profile-info">


                    <h4 class="profile-section-title mb-4">

                        Personal Information

                    </h4>







                    <p>

                        <strong>
                            Name:
                        </strong>

                        <br />

                        @Model.FullName

                    </p>








                    <p>

                        <strong>
                            Mobile:
                        </strong>

                        <br />

                        @Model.Mobile

                    </p>








                    <p>

                        <strong>
                            Email:
                        </strong>

                        <br />

                        @Model.Email

                    </p>








                    <p>

                        <strong>
                            Father Number:
                        </strong>

                        <br />

                        @Model.FathersNumber

                    </p>








                    <p>

                        <strong>
                            Mother Number:
                        </strong>

                        <br />

                        @Model.MothersNumber

                    </p>








                    <p class="border-0 mb-0">

                        <strong>
                            Account Status:
                        </strong>

                        <br />



                        @if (Model.IsApproved)
                        {

                            <span class="badge bg-success mt-1">

                                Approved

                            </span>

                        }
                        else
                        {

                            <span class="badge bg-warning text-dark mt-1">

                                Pending

                            </span>

                        }


                    </p>



                </div>


            </div>


        </div>









        <!-- STUDENT ACTIVITY -->


        <div class="col-md-6 mb-4">


            <div class="card shadow h-100">


                <div class="card-body p-4">


                    <h4 class="profile-section-title mb-4">

                        Student Activity 📊

                    </h4>








                    <div class="row text-center">





                        <div class="col-6 mb-3">


                            <div class="card activity-card p-3 h-100">


                                <div class="activity-number">

                                    @ViewBag.PostedItems

                                </div>


                                <small class="text-muted">

                                    Posted Items

                                </small>


                            </div>


                        </div>








                        <div class="col-6 mb-3">


                            <div class="card activity-card p-3 h-100">


                                <div class="activity-number">

                                    @ViewBag.RentedItems

                                </div>


                                <small class="text-muted">

                                    Rented Items

                                </small>


                            </div>


                        </div>








                        <div class="col-6 mb-3">


                            <div class="card activity-card p-3 h-100">


                                <div class="activity-number">

                                    @ViewBag.Payments

                                </div>


                                <small class="text-muted">

                                    Payments

                                </small>


                            </div>


                        </div>








                        <div class="col-6 mb-3">


                            <div class="card activity-card p-3 h-100">


                                <div class="activity-number">

                                    @ViewBag.ExtraCharges

                                </div>


                                <small class="text-muted">

                                    Extra Charges

                                </small>


                            </div>


                        </div>



                    </div>



                </div>


            </div>


        </div>



    </div>









    <!-- STUDENT ID CARD -->


    <div class="card shadow mb-4">


        <div class="card-body p-4 text-center">



            <h4 class="profile-section-title mb-4">

                Student ID Card 🪪

            </h4>







            @if (!string.IsNullOrEmpty(Model.StudentIdCardImage))
            {


                <img src="@Model.StudentIdCardImage"
                     class="img-fluid rounded shadow mx-auto"
                     style="max-width:350px; max-height:260px; object-fit:contain;" />


            }
            else
            {


                <div class="alert alert-light border">

                    No ID Card Uploaded

                </div>


            }



        </div>


    </div>









    <!-- ACCOUNT SETTINGS -->


    <div class="card shadow mb-4">


        <div class="card-body p-4 text-center">


            <h4 class="profile-section-title mb-3">

                Account Settings ⚙️

            </h4>



            <p class="text-muted">

                Update your account information or change your password.

            </p>








            <a href="/Account/EditProfile"
               class="btn sea-btn me-2 mb-2">


                ✏️ Edit Profile


            </a>







            <a href="/Account/ChangePassword"
               class="btn sea-outline-btn mb-2">


                🔐 Change Password


            </a>



        </div>


    </div>









    <div class="mb-4">


        <a href="/Account/Dashboard"
           class="btn btn-dark">


            ← Back To Dashboard


        </a>


    </div>





</div>