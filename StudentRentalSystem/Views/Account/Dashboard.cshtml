@model StudentRentalSystem.Models.Student


<h2>
    Welcome, @Model.FullName
</h2>


<hr />


<h3>
    Student Dashboard
</h3>



<p>
    Mobile:
    @Model.Mobile
</p>



<p>
    Email:
    @Model.Email
</p>



<p>
    Account Status:
</p>



@if (Model.IsApproved)
{
    <p>
        Approved
    </p>
}
else
{
    <p>
        Pending Approval
    </p>
}



