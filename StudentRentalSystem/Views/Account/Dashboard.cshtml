@model StudentRentalSystem.Models.Student


@{
    ViewData["Title"] = "Dashboard";
}



<div class="container mt-4">





    <!-- USER INFO CARD -->

    <div class="card shadow mb-4">


        <div class="card-body">


            <h2 class="card-title">

                Welcome, @Model.FullName 👋

            </h2>



            <hr />



            <p>
                <strong>
                    Mobile:
                </strong>

                @Model.Mobile
            </p>





            <p>
                <strong>
                    Email:
                </strong>

                @Model.Email
            </p>





            <p>

                <strong>
                    Account Status:
                </strong>



                @if (Model.IsApproved)
                {

                    <span class="badge bg-success">

                        Approved

                    </span>

                }

                else
                {

                    <span class="badge bg-warning text-dark">

                        Pending Approval

                    </span>

                }


            </p>



        </div>


    </div>









    <h3 class="mb-3">

        Student Dashboard

    </h3>








    <div class="row">







        <!-- PROFILE -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5 class="card-title">

                        Profile

                    </h5>



                    <p>

                        View your personal information.

                    </p>



                    <a href="/Account/Profile"
                       class="btn btn-primary">


                        View Profile


                    </a>


                </div>


            </div>


        </div>










        <!-- ITEM MANAGEMENT -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5 class="card-title">

                        My Items

                    </h5>



                    <p>

                        Post and manage your items.

                    </p>



                    <a href="/Item/Create"
                       class="btn btn-success">


                        Post New Item


                    </a>



                    <br />
                    <br />



                    <a href="/Item/MyItems"
                       class="btn btn-outline-success">


                        View My Items


                    </a>


                </div>


            </div>


        </div>










        <!-- RENTAL -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5 class="card-title">

                        Rental System

                    </h5>



                    <p>

                        Browse and manage rentals.

                    </p>



                    <a href="/Item/Browse"
                       class="btn btn-info">


                        Browse Items


                    </a>



                    <br />
                    <br />



                    <a href="/Rental/MyRentals"
                       class="btn btn-outline-info">


                        My Rentals


                    </a>


                </div>


            </div>


        </div>






    </div>









    <div class="row mt-3">







        <!-- PAYMENT -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5>

                        Payments

                    </h5>



                    <p>

                        Check your payment history.

                    </p>



                    <a href="/Payment/MyPayments"
                       class="btn btn-success">


                        My Payments


                    </a>


                </div>


            </div>


        </div>










        <!-- EXTRA CHARGES -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5>

                        Extra Charges

                    </h5>



                    <p>

                        Check late return charges.

                    </p>



                    <a href="/ExtraCharge/MyCharges"
                       class="btn btn-danger">


                        View Charges


                    </a>


                </div>


            </div>


        </div>










        <!-- ACCOUNT -->


        <div class="col-md-4 mb-3">


            <div class="card shadow h-100">


                <div class="card-body">


                    <h5>

                        Account

                    </h5>



                    <p>

                        Logout from your account.

                    </p>



                    <a href="/Account/Logout"
                       class="btn btn-dark">


                        Logout


                    </a>


                </div>


            </div>


        </div>





    </div>







</div>