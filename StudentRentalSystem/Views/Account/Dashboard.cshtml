@model StudentRentalSystem.Models.Student


@{
    ViewData["Title"] = "Dashboard";
}






<div class="container mt-4">








    <!-- WELCOME CARD -->


    <div class="card shadow mb-4">


        <div class="card-body text-center">



            <h2 class="fw-bold">

                Welcome, @Model.FullName 👋

            </h2>



            <p class="text-muted">

                Student Rental System Dashboard

            </p>




            <hr />





            <div class="row text-start">



                <div class="col-md-4 mb-2">

                    <strong>
                        Mobile:
                    </strong>

                    <br />

                    @Model.Mobile

                </div>






                <div class="col-md-4 mb-2">

                    <strong>
                        Email:
                    </strong>

                    <br />

                    @Model.Email

                </div>






                <div class="col-md-4 mb-2">

                    <strong>
                        Status:
                    </strong>

                    <br />



                    @if (Model.IsApproved)
                    {

                        <span class="badge bg-success">

                            Approved

                        </span>

                    }
                    else
                    {

                        <span class="badge bg-warning text-dark">

                            Pending Approval

                        </span>

                    }



                </div>



            </div>



        </div>


    </div>









    <h3 class="mb-4 fw-bold">

        Student Dashboard 📚

    </h3>








    <div class="row">







        <!-- PROFILE -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        👤 Profile

                    </h5>



                    <p>

                        Manage your personal information.

                    </p>



                    <a href="/Account/Profile"
                       class="btn btn-primary">


                        View Profile


                    </a>


                </div>


            </div>


        </div>










        <!-- ITEMS -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        📦 My Items

                    </h5>



                    <p>

                        Post and manage your rental items.

                    </p>



                    <a href="/Item/Create"
                       class="btn btn-success mb-2">


                        + Post Item


                    </a>



                    <br />



                    <a href="/Item/MyItems"
                       class="btn btn-outline-success">


                        My Items


                    </a>


                </div>


            </div>


        </div>










        <!-- RENTAL -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        🔄 Rental System

                    </h5>



                    <p>

                        Browse and manage rentals.

                    </p>




                    <a href="/Item/Browse"
                       class="btn btn-primary mb-2">


                        Browse Items


                    </a>




                    <br />




                    <a href="/Rental/MyRentals"
                       class="btn btn-outline-primary mb-2">


                        My Rentals


                    </a>



                    <br />




                    <a href="/Rental/MyRentedItems"
                       class="btn btn-outline-success">


                        Rented Items


                    </a>


                </div>


            </div>


        </div>






    </div>









    <div class="row">








        <!-- PAYMENT -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        💳 Payments

                    </h5>



                    <p>

                        View payment history.

                    </p>




                    <a href="/Payment/MyPayments"
                       class="btn btn-success">


                        My Payments


                    </a>



                </div>


            </div>


        </div>










        <!-- CHARGES -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        💰 Extra Charges

                    </h5>



                    <p>

                        Manage late return charges.

                    </p>




                    <a href="/ExtraCharge/MyCharges"
                       class="btn btn-danger">


                        View Charges


                    </a>



                </div>


            </div>


        </div>










        <!-- ACCOUNT -->


        <div class="col-md-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h5>

                        ⚙️ Account

                    </h5>



                    <p>

                        Logout safely.

                    </p>




                    <a href="/Account/Logout"
                       class="btn btn-dark">


                        Logout


                    </a>



                </div>


            </div>


        </div>





    </div>






</div>