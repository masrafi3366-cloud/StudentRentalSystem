@model IEnumerable<StudentRentalSystem.Models.Item>


@{
    ViewData["Title"] = "Browse Items";
}



<div class="container mt-4">


    <h2 class="mb-4">
        Available Items
    </h2>




    <div class="row">



        @foreach (var item in Model)
        {


            <div class="col-md-4 mb-4">


                <div class="card shadow h-100">



                    @if (item.Image != null)
                    {

                        <img src="@item.Image"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;" />

                    }




                    <div class="card-body">



                        <h5 class="card-title">
                            @item.ItemName
                        </h5>



                        <p class="card-text">

                            Category:

                            @item.Category

                        </p>




                        <p class="card-text">

                            Price Per Day:

                            <strong>
                                @item.PricePerDay
                            </strong>

                        </p>





                        <a href="/Item/Details/@item.ItemId"
                           class="btn btn-primary">

                            View Details

                        </a>



                    </div>



                </div>


            </div>


        }



    </div>


</div>