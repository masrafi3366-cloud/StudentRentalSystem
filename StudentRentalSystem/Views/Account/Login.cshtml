<h2>
    Student Login
</h2>



<form method="post">


    <label>
        Email
    </label>

    <input type="email" name="email" />


    <br />


    <label>
        Password
    </label>

    <input type="password" name="password" />


    <br />


    <button type="submit">
        Login
    </button>


</form>



@if (ViewBag.Error != null)
{

    <p>
        @ViewBag.Error
    </p>

}